# =============================================================================
# youtube-ai-automation — Environment Configuration
# Copy this file to .env and fill in your own values.
# See docs/SETUP.md and docs/API_KEYS.md for step-by-step instructions.
# Never commit your real .env file.
# =============================================================================

# --- General ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- YouTube OAuth2 (Google Cloud Console) ----------------------------------
# See docs/API_KEYS.md for exactly where to find/create each of these.
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Generate this by running: npm run generate-refresh-token
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# --- Google Gemini -----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Folders (relative to project root, or absolute paths) ------------------
VIDEOS_FOLDER=./videos
UPLOADED_FOLDER=./uploaded
FAILED_FOLDER=./failed

# --- Database -----------------------------------------------------------------
DATABASE_PATH=./data/uploads.sqlite

# --- Scheduler ------------------------------------------------------------
# Standard cron syntax. Default below runs every 30 minutes.
CRON_EXPRESSION=*/30 * * * *
MAX_UPLOADS_PER_RUN=1

# --- Upload defaults ---------------------------------------------------------
# YouTube category ID. 22 = People & Blogs. See docs/API_KEYS.md for a list.
DEFAULT_CATEGORY=22
# One of: private | public | unlisted
DEFAULT_PRIVACY=private
DEFAULT_TIMEZONE=UTC
# If > 0, uploads are scheduled this many minutes in the future instead of
# publishing (or going private) immediately.
UPLOAD_SCHEDULE_DELAY_MINUTES=0

# --- Logging ------------------------------------------------------------------
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Storage provider ---------------------------------------------------------
# One of: local | gdrive
# "local" (default) uses the videos/uploaded/failed folders on disk, exactly
# as before. "gdrive" uses Google Drive folders of the same names instead.
# See docs/SETUP.md for the full Google Drive setup walkthrough.
STORAGE_PROVIDER=local

# --- Google Drive (only required when STORAGE_PROVIDER=gdrive) ----------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Generate this by running: npm run generate-gdrive-refresh-token
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: exact Drive folder IDs to use for videos/uploaded/failed. If left
# blank, the app automatically finds (or creates) folders with these names
# at the root of the authorized Google Drive account.
GOOGLE_DRIVE_FOLDER_VIDEOS=
GOOGLE_DRIVE_FOLDER_UPLOADED=
GOOGLE_DRIVE_FOLDER_FAILED=

